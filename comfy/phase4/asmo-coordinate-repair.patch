+# ASMO_COORDINATE_ADAPTER_V1
+def normalize_gemma_subjects(subjects):
+    import math
+    if not isinstance(subjects, list):
+        raise ValueError("Missing Gemma subject list.")
+    result = []
+    for subject in subjects:
+        box = subject.get("box")
+        if not isinstance(box, list) or len(box) != 4:
+            raise ValueError("Invalid Gemma bounding box.")
+        if any(isinstance(v, bool) or
+               not isinstance(v, (int, float)) or
+               not math.isfinite(v) or
+               not 0 <= v <= 1000 for v in box):
+            raise ValueError("Gemma coordinates outside 0-1000.")
+        y1, x1, y2, x2 = box
+        result.append(dict(subject, box=[
+            x1 / 1000, y1 / 1000,
+            x2 / 1000, y2 / 1000
+        ]))
+    return result
+
+
+def merge_coordinate_retry(source, retry):
+    subjects = source['subjects']
+    labels = [s['label'] for s in subjects]
+    returned = retry['subjects']
+    boxes = {s['label']: s['box'] for s in returned}
+    if (len(boxes) != len(returned) or
+            len(set(labels)) != len(labels) or
+            set(boxes) != set(labels)):
+        raise ValueError("Coordinate retry subject labels do not match.")
+    return dict(source, subjects=[
+        dict(s, box=boxes[s['label']]) for s in subjects
+    ])
 
 
